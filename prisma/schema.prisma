generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
 
}

model Song {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  artist    String?
  fileName  String
  mimeType  String
  fileSize  Int
  fileData  Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@map("songs")
}

model PianoSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  @@map("piano_settings")
}
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@index([username])
  @@map("users")
}

